@{
    ViewData["Title"] = "Welcome";
}
<section class="welcome-banner">
    <p class="eyebrow">A little different. A little you.</p>
    <h1>Your next great find<br />starts here.</h1>
    <p>We're getting the marketplace ready.<br />Come back soon to discover what's new.</p>
    @if (User.Identity?.IsAuthenticated == true)
    {
        <a class="button dark" asp-controller="Account" asp-action="Me">Go to your account <span aria-hidden="true">→</span></a>
    }
    else
    {
        <a class="button dark" asp-controller="Account" asp-action="Register">Create an account <span aria-hidden="true">→</span></a>
    }
</section>
<section class="marketplace-state" aria-labelledby="marketplace-title">
    <span class="state-symbol" aria-hidden="true">◇</span>
    <h2 id="marketplace-title">Good things are on their way</h2>
    <p>Shopping isn't available just yet. You can create an account or sign in while we get ready.</p>
</section>
