@model EbayGroup5.Web.Models.CheckoutPage
@using System.Globalization
@{ ViewData["Title"] = "Checkout"; ViewData["Shell"] = "checkout";
    var item = Model.Product.Item; var image = item.Images.FirstOrDefault();
    var noAddress = Model.Addresses.Count == 0; var soldOut = Model.Product.Quantity == 0;
    var total = "US $" + (item.Price * Model.Form.Quantity).ToString("N2", CultureInfo.InvariantCulture); }
@* H06a (CHECKOUT.md, reference C2): eBay checkout. The clone only has COD and one free delivery option (ADR-003 §3). *@
<h1 class="sr-only">Checkout</h1>
<form asp-action="Place" method="post" class="co-grid">
    <input type="hidden" name="ProductId" value="@Model.Form.ProductId" />
    <input type="hidden" name="Key" value="@Model.Form.Key" />
    <input type="hidden" name="ExpectedUnitPrice" value="@Model.Form.ExpectedUnitPrice.ToString(CultureInfo.InvariantCulture)" />
    <div class="co-main">
        @if (!ViewData.ModelState.IsValid) { <div asp-validation-summary="All" class="validation-errors" role="alert"></div> }
        <section class="co-section" aria-labelledby="pay-title"><h2 id="pay-title">Pay with</h2>
            <label class="co-option"><input type="radio" checked /><span><strong>Cash on delivery</strong><span class="co-muted">Pay when your order arrives. No money is collected in this demo.</span></span></label>
        </section>
        <section class="co-section" aria-labelledby="ship-title"><h2 id="ship-title">Ship to</h2>
            @if (noAddress) { <p>Add a shipping address to continue.</p> }
            @foreach (var address in Model.Addresses)
            {
                <label class="co-option co-address"><input type="radio" name="AddressId" value="@address.Id" checked="@(address.Id == Model.Form.AddressId)" required />
                    <span><strong>@address.FullName</strong><br />@address.Street<br />@address.City @address.State<br />@address.Country<br />@address.Phone</span>
                </label>
            }
            <a id="add-address" class="co-link" asp-action="AddAddress" asp-route-productId="@Model.Form.ProductId" asp-route-quantity="@Model.Form.Quantity">Add a new address</a>
        </section>
        <section class="co-section" aria-labelledby="review-title"><h2 id="review-title">Review order</h2>
            <div class="co-seller"><span class="seller-avatar" aria-hidden="true">@item.Seller[0]</span>
                <span><a asp-controller="Sellers" asp-action="Feedback" asp-route-id="@item.SellerId">@item.Seller</a>@if (Model.Reputation.PositivePercent is decimal positive) { <small>@positive.ToString("0.#", CultureInfo.InvariantCulture)% positive feedback</small> }</span></div>
            <div class="co-item">
                @if (image != null) { <img class="co-item-image" src="@image" alt="" /> }
                else { <div class="co-item-image product-placeholder" aria-hidden="true"><svg viewBox="0 0 64 64"><path d="M12 20 32 10 52 20 32 30Z M12 20v24l20 10 20-10V20 M32 30v24" /></svg></div> }
                <div class="co-item-text">
                    <a class="co-item-title" asp-controller="Catalog" asp-action="Details" asp-route-id="@item.Id">@item.Title</a>
                    <p class="co-item-price">US $@item.Price.ToString("N2", CultureInfo.InvariantCulture)</p>
                    <div class="box-field co-quantity"><label for="quantity">Quantity</label><input id="quantity" name="Quantity" data-unit-price="@item.Price.ToString(CultureInfo.InvariantCulture)" type="number" min="1" max="99" value="@Model.Form.Quantity" required /></div>
                    <p class="co-muted">@Model.Product.Quantity available. Availability is checked when you confirm.</p>
                    <p class="co-muted">Returns accepted</p>
                    <fieldset class="co-delivery"><legend>Delivery</legend>
                        <label class="co-delivery-option"><input type="radio" checked /><span>Est. delivery: @Model.EstimatedDelivery.ToString("MMM d", CultureInfo.InvariantCulture)<br />Standard Shipping<br /><strong>Free</strong></span></label>
                    </fieldset>
                </div>
            </div>
        </section>
    </div>
    <aside class="co-summary" aria-labelledby="summary-title"><h2 id="summary-title">Order Summary</h2>
        <dl class="co-lines"><div><dt>Item (<span id="summary-quantity">@Model.Form.Quantity</span>)</dt><dd data-summary-total>@total</dd></div><div><dt>Shipping</dt><dd>Free</dd></div></dl>
        <p class="co-total"><span>Order total</span><strong data-summary-total>@total</strong></p>
        <button class="button primary co-pay" type="submit" disabled="@(noAddress || soldOut)">Confirm and pay</button>
        <p class="co-pay-note">@(noAddress ? "Add a shipping address" : soldOut ? "This item is out of stock" : "Cash on delivery. No money is collected.")</p>
        <p class="co-guarantee"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2 4 5v6c0 5 3.4 9.4 8 11 4.6-1.6 8-6 8-11V5Zm-1.2 13.6L7.4 12.2l1.4-1.4 2 2 4.4-4.4 1.4 1.4Z" /></svg><span>Purchase protected by <strong>eBay Money Back Guarantee</strong></span></p>
        <p class="field-help">USD demo. The total is computed again when you confirm; no real payment or delivery is arranged.</p>
    </aside>
</form>
@section Scripts { <script src="~/js/checkout.js" asp-append-version="true"></script> }
