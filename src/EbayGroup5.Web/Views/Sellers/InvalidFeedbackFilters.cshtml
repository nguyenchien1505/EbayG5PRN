@model int
@{ ViewData["Title"] = "Check your feedback filters"; }
<section class="marketplace-state"><h1>Let's try those filters again</h1><p>Use a positive page number, 25, 50 or 100 items per page, a period of 1, 6 or 12 months and a search of at most 100 characters.</p><a class="button primary" asp-action="Feedback" asp-route-id="@Model">See all feedback</a></section>
