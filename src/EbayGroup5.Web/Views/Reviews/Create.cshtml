@model EbayGroup5.Web.Models.ReviewPage
@using EbayGroup5.Application.Feedback
@using EbayGroup5.Application.Reviews
@using System.Globalization
@{
    ViewData["Title"] = "Leave feedback";
    var line = Model.Context.Line;
    var seller = Model.Feedback;
    var anyForm = line.CanReview || seller.CanLeave;
}
<a class="back-to-catalog" asp-controller="Orders" asp-action="Details" asp-route-id="@Model.Context.OrderId">← Back to order #@Model.Context.OrderId</a>
<h1>Leave feedback</h1>
@if (ViewData["ReviewError"] is string error) { <div class="validation-errors" role="alert">@error</div> }
<section class="review-card" aria-labelledby="review-item">
    <div class="review-item-row">
        <div class="order-item-icon product-placeholder"><svg viewBox="0 0 64 64" aria-hidden="true"><path d="M12 20 32 10 52 20 32 30Z M12 20v24l20 10 20-10V20 M32 30v24" /></svg></div>
        <div><h2 id="review-item">@line.Title</h2><p class="field-help">Order #@Model.Context.OrderId</p></div>
    </div>
    <form asp-action="Create" method="post" class="review-form">
        <input type="hidden" name="OrderItemId" value="@line.OrderItemId" />
        <div class="review-row">
            <h3 class="review-row-title">How was your experience?<span class="field-help">Rate your overall experience with this seller.</span></h3>
            <div>
                @if (seller.CanLeave)
                {
                    <fieldset class="sentiment-input">
                        <legend class="sr-only">Seller experience</legend>
                        @foreach (var option in Enum.GetValues<FeedbackSentiment>())
                        {
                            var disabled = seller.PositiveOnly && option != FeedbackSentiment.Positive;
                            <input type="radio" id="sentiment-@option" name="Sentiment" value="@option" checked="@(Model.Form.Sentiment == option)" disabled="@disabled" />
                            <label for="sentiment-@option">@option</label>
                        }
                    </fieldset>
                    @if (seller.PositiveOnly && seller.NeutralNegativeFromUtc is { } opens)
                    { <p class="field-help sentiment-note">ⓘ You need to wait 7 days before you can leave neutral or negative feedback for this seller. Available from @opens.ToString("MMM dd, yyyy HH:mm", CultureInfo.InvariantCulture) UTC.</p> }
                    <label class="sr-only" for="seller-comment">Tell us about this seller (optional)</label>
                    <textarea id="seller-comment" name="SellerComment" maxlength="@FeedbackLimits.MaxCommentLength" rows="3" placeholder="Tell us about this seller (optional)." data-count-target="seller-count">@Model.Form.SellerComment</textarea>
                    <p class="field-help review-count"><span id="seller-count">@(Model.Form.SellerComment?.Length ?? 0)</span> / @FeedbackLimits.MaxCommentLength</p>
                    @if (seller.DeadlineUtc is { } deadline) { <p class="field-help">Seller feedback is open until @deadline.ToString("MMM dd, yyyy", CultureInfo.InvariantCulture). It can't be edited after posting.</p> }
                }
                else if (seller.Left && seller.Sentiment is { } left) { <p>You left @left feedback for the seller.</p> }
                else { <p class="order-notice">@seller.Reason</p> }
            </div>
        </div>
        @if (line.CanReview)
        {
            <fieldset class="review-row">
                <legend>How would you rate this item?</legend>
                <div class="star-input">
                    @for (var star = ReviewLimits.MaxRating; star >= ReviewLimits.MinRating; star--)
                    {
                        <input type="radio" id="rating-@star" name="Rating" value="@star" checked="@(Model.Form.Rating == star)" />
                        <label for="rating-@star" title="@star star@(star == 1 ? "" : "s")"><span class="sr-only">@star star@(star == 1 ? "" : "s")</span></label>
                    }
                </div>
            </fieldset>
            <div class="review-row">
                <label for="review-comment">Tell us more about this item <span class="field-help">(optional)</span></label>
                <div>
                    <textarea id="review-comment" name="Comment" maxlength="@ReviewLimits.MaxCommentLength" rows="6" placeholder="Share your experience with this item." data-count-target="review-count">@Model.Form.Comment</textarea>
                    <p class="field-help review-count"><span id="review-count" data-review-count>@(Model.Form.Comment?.Length ?? 0)</span> / @ReviewLimits.MaxCommentLength</p>
                </div>
            </div>
        }
        else
        {
            <div class="review-row">
                <h3 class="review-row-title">Item rating</h3>
                <div>
                    @if (line.Reviewed && line.Rating is int rating)
                    {
                        <p class="review-done"><partial name="_Stars" model="(decimal)rating" /> You rated this item @rating out of 5.</p>
                        @if (line.ProductId is int productId) { <p><a asp-controller="Catalog" asp-action="Reviews" asp-route-id="@productId">See all reviews for this item</a></p> }
                    }
                    else { <p class="order-notice">@line.Reason</p> }
                </div>
            </div>
        }
        @if (anyForm)
        {
            <p class="field-help">Feedback and reviews are public with your username. Item reviews show a Verified purchase label. Neither can be edited after posting.</p>
            <button type="submit" class="button primary">Leave feedback</button>
        }
    </form>
</section>
@section Scripts {
    <script>
        document.querySelectorAll('[data-count-target]').forEach(box => {
            const count = document.getElementById(box.dataset.countTarget);
            if (count) box.addEventListener('input', () => { count.textContent = box.value.length; });
        });
    </script>
}
