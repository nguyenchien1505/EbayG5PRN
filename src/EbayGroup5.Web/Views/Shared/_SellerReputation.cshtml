@model EbayGroup5.Application.Feedback.SellerReputation
@using System.Globalization
@if (Model.Total == 0)
{
    <span class="seller-reputation">No feedback yet</span>
}
else
{
    <span class="seller-reputation"><span title="Feedback score">(@Model.Score.ToString(CultureInfo.InvariantCulture)<partial name="_FeedbackStar" model="Model.Star" />)</span>
        @if (Model.PositivePercent is decimal percent) { <span>@percent.ToString("0.#", CultureInfo.InvariantCulture)% positive feedback <span class="field-help">(12 months)</span></span> }
        else if (Model.Month12.Total == 0) { <span>No feedback in the last 12 months</span> }
        else { <span>Neutral feedback only (12 months)</span> }</span>
}
