@model IReadOnlyList<EbayGroup5.Application.Reviews.ProductReview>
@using System.Globalization
<ol class="review-list">
    @foreach (var review in Model)
    {
        <li class="review-item">
            <div class="review-meta"><partial name="_Stars" model="(decimal)review.Rating" /><strong>@review.Reviewer</strong><span class="verified-badge">Verified purchase</span></div>
            <p class="field-help">@review.CreatedAt.ToString("MMM dd, yyyy", CultureInfo.InvariantCulture)</p>
            <p class="review-comment">@review.Comment</p>
        </li>
    }
</ol>
