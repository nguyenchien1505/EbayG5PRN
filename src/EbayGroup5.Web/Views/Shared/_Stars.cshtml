@model decimal
@using System.Globalization
@{ var value = Math.Clamp(Model, 0m, 5m); var label = value.ToString("0.#", CultureInfo.InvariantCulture) + " out of 5 stars"; }
<span class="stars" role="img" aria-label="@label" title="@label"><span class="stars-fill pct-@(Math.Round(value * 20m, MidpointRounding.AwayFromZero).ToString("0", CultureInfo.InvariantCulture))"></span></span>
