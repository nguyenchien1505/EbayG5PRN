@model EbayGroup5.Application.Orders.OrderDetail
@using EbayGroup5.Application.Orders
@using System.Globalization
@{ ViewData["Title"] = "Order details"; var buyer = Model.Audience == OrderAudience.Buyer; var history = buyer ? "Purchases" : "Sales";
    var reviewLines = (ViewData["ReviewLines"] as IReadOnlyList<EbayGroup5.Application.Reviews.ReviewLineEligibility>)?.ToDictionary(x => x.OrderItemId);
    var feedbackLines = (ViewData["FeedbackLines"] as IReadOnlyList<EbayGroup5.Application.Feedback.FeedbackLineEligibility>)?.ToDictionary(x => x.OrderItemId);
    var disputeLines = ViewData["DisputeLines"] as IReadOnlyDictionary<int, EbayGroup5.Application.Disputes.DisputeEligibility>;
    var disputeTiming = ViewData["DisputeTiming"] as EbayGroup5.Application.Disputes.DisputeTiming;
    var sellerRequests = ViewData["SellerRequests"] as IReadOnlyDictionary<int, IReadOnlyList<EbayGroup5.Application.Disputes.DisputeSummary>>;
    string Day(DateTime? value) => value?.ToString("MMM d, yyyy", CultureInfo.InvariantCulture) ?? "";
    var shipped = Model.Status is "Shipped" or "Delivered"; var delivered = Model.Status == "Delivered";
    // H06b (OD): only dates the clone records — order date, and the COD payment recorded on delivery.
    var steps = Model.Status is "Pending" or "Shipped" or "Delivered"
        ? new[] { ("Order placed", true, Day(Model.Date)), ("Shipped", shipped, ""), ("Delivered", delivered, delivered ? Day(Model.PaidAt) : "") } : [];
    var summary = Model.Status switch
    {
        "Pending" => buyer ? "The seller hasn't shipped your order yet." : "Ship this order to the buyer.",
        "Shipped" => buyer ? "Your order is on its way. Confirm when it arrives." : "Waiting for the buyer to confirm delivery.",
        "Delivered" => buyer ? "Great! Your order was delivered." : "Great! Your sale is complete.",
        "Cancelled" => "This order was cancelled.",
        _ => "This order's status is unavailable."
    }; }
@* H06b (ORDERS.md, reference OD): status card, Item, Shipping, Order and Payment. Group 5 line actions keep their D06/E02/E03 markup. *@
<a class="back-to-catalog" asp-action="@history">← Back to @history.ToLowerInvariant()</a>
<h1 class="od-title">Order details</h1>
@if(TempData["OrderNotice"] is string orderNotice) { <p class="account-notice" role="status">@orderNotice</p> }
@if(ViewData["OrderError"] is string error) { <div class="validation-errors" role="alert">@error</div> }
@if(Model.Notice != null) { <p class="order-notice">@Model.Notice</p> }
<div class="od-grid"><div class="od-main">
<section class="od-card" aria-labelledby="od-status"><h2 id="od-status"><span class="order-status">@Model.Status</span>@if (delivered && Model.PaidAt != null) { <text> on @Model.PaidAt.Value.ToString("MMM d", CultureInfo.InvariantCulture)</text> }</h2>
    <p>@summary</p>
    @if (steps.Length > 0) { <ol class="od-progress">@foreach (var (label, done, date) in steps) { <li class="@(done ? "done" : null)"><span class="od-dot" aria-hidden="true"></span><strong>@label</strong>@if (done && date != "") { <span>@date</span> }<span class="sr-only">@(done ? "(done)" : "(not yet)")</span></li> }</ol> }
    @if(Model.CanShip) { <form asp-action="Ship" method="post"><input type="hidden" name="id" value="@Model.Id"/><button type="submit" class="button primary od-action">Mark as shipped</button></form><p class="field-help">Creates a simulated shipment for this order.</p> }
    @if(Model.CanReceive) { <form asp-action="Receive" method="post"><input type="hidden" name="id" value="@Model.Id"/><button type="submit" class="button primary od-action">Confirm received</button></form><p class="field-help">Confirm only after receiving the item in this demo. Records COD as paid without collecting money.</p> }
</section>
<section class="od-card" aria-labelledby="od-items"><h2 id="od-items">Item</h2>
    @foreach(var item in Model.Lines) { <div class="order-line" id="line-@item.Id"><div class="od-item">
        @if (item.Image != null) { <img class="order-item-icon order-item-photo" src="@item.Image" alt="" /> }
        else { <div class="order-item-icon product-placeholder" aria-hidden="true"><svg viewBox="0 0 64 64"><path d="M12 20 32 10 52 20 32 30Z M12 20v24l20 10 20-10V20 M32 30v24" /></svg></div> }
        <div class="order-item-text">@if (item.ProductId is int productId) { <a asp-controller="Catalog" asp-action="Details" asp-route-id="@productId"><strong>@item.Title</strong></a> } else { <strong>@item.Title</strong> }
            <p>Quantity: @(item.Quantity?.ToString() ?? "Unavailable")<br />Price: @(item.UnitPrice is decimal price ? "US $" + price.ToString("N2", CultureInfo.InvariantCulture) : "Unavailable")</p></div></div>
        <div class="order-line-actions">@if(buyer && item.ProductId != null) { <button type="button" class="chat-contact" data-chat-order-item-id="@item.Id">Contact seller</button> }
        @if(reviewLines != null && reviewLines.TryGetValue(item.Id, out var review)) {
            var sellerFeedback = feedbackLines?.GetValueOrDefault(item.Id);
            if(review.CanReview || sellerFeedback?.CanLeave == true) { <a class="button outline review-action" asp-controller="Reviews" asp-action="Create" asp-route-orderItemId="@item.Id">Leave feedback</a> }
            if(sellerFeedback is { Left: true, Sentiment: { } sentiment }) { <p class="review-done">You left @sentiment feedback for the seller.</p> }
            if(review.Reviewed && review.Rating is int rated) { <p class="review-done"><partial name="_Stars" model="(decimal)rated" /> You rated this item @rated out of 5.</p> }
            else if(!review.CanReview && sellerFeedback?.CanLeave != true && sellerFeedback?.Left != true && Model.Status != "Cancelled") { <p class="field-help">@(sellerFeedback?.Reason ?? review.Reason)</p> }
        }
        @if(disputeLines?.GetValueOrDefault(item.Id) is { } dispute && disputeTiming != null) {
            if(dispute.ItemNotReceived.CanOpen) { <a class="button outline review-action" asp-controller="Disputes" asp-action="NotReceived" asp-route-orderItemId="@item.Id">I didn't receive it</a> }
            if(dispute.Return.CanOpen) { <a class="button outline review-action" asp-controller="Disputes" asp-action="Return" asp-route-orderItemId="@item.Id">Return this item</a> }
            foreach(var request in dispute.Requests) { <p class="dispute-status"><a asp-controller="Disputes" asp-action="Details" asp-route-id="@request.Id"><strong>@EbayGroup5.Web.Models.DisputeText.Kind(request.Kind)</strong></a> · @EbayGroup5.Web.Models.DisputeText.Status(request, disputeTiming)</p> }
        }
        @if(sellerRequests?.GetValueOrDefault(item.Id) is { } received && disputeTiming != null) {
            foreach(var request in received) { <p class="dispute-status"><strong>@EbayGroup5.Web.Models.DisputeText.Kind(request.Kind)</strong> · @EbayGroup5.Web.Models.DisputeText.Status(request, disputeTiming, EbayGroup5.Application.Disputes.DisputeActor.Seller) · <a asp-controller="Disputes" asp-action="Details" asp-route-id="@request.Id">See request details</a></p> }
        }</div></div> }
    @if(Model.ItemCount > Model.Lines.Count) { <p class="field-help">Showing the first @Model.Lines.Count of @Model.ItemCount order lines. This legacy order is read-only.</p> }
    @if(Model.Lines.Count == 0) { <p>Item details are unavailable.</p> }
</section>
<section class="od-card" aria-labelledby="od-shipping"><h2 id="od-shipping">Shipping</h2><div class="od-columns">
    <div><h3>Ship to</h3>@if(Model.Address is {} address) { <p>@address.FullName<br/>@address.Street<br/>@address.City @address.State<br/>@address.Country<br/>@address.Phone</p> }
        else { <p>Shipping address is unavailable.</p> }</div>
    <div><h3>Delivery (demo)</h3>
        @if(Model.EstimatedDeliveryUtc is {} estimated) { <p>Estimated delivery: <strong>@estimated.ToString("ddd, MMM dd, yyyy", CultureInfo.InvariantCulture)</strong><br />Standard Shipping</p> }
        @if(Model.Tracking != null) { <p>@Model.Carrier<br/>Tracking @Model.Tracking</p><p class="field-help">Demo tracking reference. No real parcel is tracked.</p> }
        else { <p>No shipment details available.</p> }</div>
</div></section>
</div><aside class="od-side">
<section class="od-card" aria-labelledby="od-order"><h2 id="od-order">Order</h2><dl class="od-facts">
    <div><dt>Order number</dt><dd>@Model.Id</dd></div>
    <div><dt>Order date</dt><dd>@(Model.Date is null ? "Unavailable" : Day(Model.Date))</dd></div>
    <div><dt>Status</dt><dd>@Model.Status</dd></div>
</dl></section>
<section class="od-card" aria-labelledby="od-payment"><h2 id="od-payment">Payment</h2><h3>@(buyer ? "What you paid" : "What your buyer paid")</h3><dl class="od-facts">
    <div><dt>Shipping</dt><dd>Free</dd></div>
    <div class="od-total"><dt>Order total</dt><dd>@(Model.Total is decimal total ? "US $" + total.ToString("N2", CultureInfo.InvariantCulture) : "Unavailable")</dd></div>
    <div><dt>Paid with</dt><dd>@(Model.PaymentMethod == "COD" ? "Cash on delivery" : Model.PaymentMethod ?? "Unavailable") · @(Model.PaymentStatus ?? "Unavailable")</dd></div>
</dl>
    @if(Model.PaidAt is {} paidAt) { <p class="field-help">Payment recorded (demo): @paidAt.ToString("yyyy-MM-dd HH:mm", CultureInfo.InvariantCulture) UTC</p> }
    @if(delivered && Model.Notice == null) { <p class="field-help">Delivery complete. No real payment was collected.</p> }
</section>
</aside></div>
@if(buyer) { <partial name="_ChatPanel" /> }
@section Styles { <link rel="stylesheet" href="~/css/chat.css" asp-append-version="true" /> }
@section Scripts { @if(buyer) { <partial name="_ChatScripts" /> } }
