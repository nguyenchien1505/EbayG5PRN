@model EbayGroup5.Application.Orders.OrderHistory
@using EbayGroup5.Application.Orders
@using System.Globalization
@{ var action = Model.Audience == OrderAudience.Buyer ? "Purchases" : "Sales"; ViewData["Title"] = Model.Audience == OrderAudience.Buyer ? "Purchase history" : "Sales history"; }
<h1>@ViewData["Title"]</h1>
<p class="field-help">Your orders · @Model.Total results. Shipping and COD payments are simulated.</p>
<form class="order-filters" asp-action="@action" method="get"><label for="order-status">Status</label>
    <select id="order-status" name="status"><option value="">All orders</option>
        @foreach(var status in new[] {"Pending", "Shipped", "Delivered", "Cancelled"}) { <option value="@status" selected="@(Model.Status == status)">@status</option> }
    </select><button class="button outline" type="submit">Apply</button><a asp-action="@action">Clear filter</a>
</form>
@if (Model.Orders.Count == 0) { <section class="checkout-card"><h2>No orders here</h2><p>No orders match this page or filter.</p><a asp-controller="Catalog" asp-action="Index">Browse items</a></section> }
@foreach (var order in Model.Orders)
{
    <article class="order-card"><div class="order-card-heading"><strong>@order.Status</strong><span>Order #@order.Id · @(order.Date?.ToString("MMM dd, yyyy", CultureInfo.InvariantCulture) ?? "Date unavailable")</span></div>
        <div class="order-card-content"><div class="order-item-icon product-placeholder" aria-hidden="true"><svg viewBox="0 0 64 64"><path d="M12 20 32 10 52 20 32 30Z M12 20v24l20 10 20-10V20 M32 30v24" /></svg></div>
            <div class="order-item-text"><h2><a asp-action="Details" asp-route-id="@order.Id">@order.Title</a></h2><p>@order.ItemCount order line(s)</p><strong>Total: @(order.Total is decimal total ? "US $" + total.ToString("N2", CultureInfo.InvariantCulture) : "Unavailable")</strong></div>
            <a class="button outline" asp-action="Details" asp-route-id="@order.Id">View order details</a>
        </div>
    </article>
}
<nav class="pagination" aria-label="Order history pages">
    @if(Model.Page > 1) { <a asp-action="@action" asp-route-page="@(Model.Page-1)" asp-route-status="@Model.Status">← Previous</a> }
    <span>Page @Model.Page of @Math.Max(1, Model.TotalPages)</span>
    @if(Model.Page < Model.TotalPages) { <a asp-action="@action" asp-route-page="@(Model.Page+1)" asp-route-status="@Model.Status">Next →</a> }
</nav>
