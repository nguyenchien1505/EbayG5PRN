# Run scripts/Initialize-LocalEnvironment.ps1 to generate .env with random passwords.
# Do not use these placeholders as credentials. Keep .env private and untracked.
# Initialize-Database.ps1 separately creates ignored .env.database for the runtime login.
SQLSERVER_PORT=14335
REDIS_PORT=16379
MSSQL_SA_PASSWORD=GENERATE_WITH_SETUP_SCRIPT
REDIS_PASSWORD=GENERATE_WITH_SETUP_SCRIPT
