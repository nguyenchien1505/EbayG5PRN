# F01 (docs/architecture/DEPLOYMENT.md). The nginx image renders ${PUBLIC_HTTPS_PORT} with envsubst; nginx variables stay as-is.
server_tokens off;

# No query strings in access logs (they may carry user input).
log_format ebaygroup5 '$remote_addr [$time_iso8601] "$request_method $uri" $status $body_bytes_sent $request_time rid=$request_id upstream=$upstream_addr';

# F03 (JOURNEYS.md): W3C trace context from the nginx request id, so app traces (and Message.TraceId) equal "rid" in this log.
# $request_id is 32 hex characters (a valid trace-id); its first 16 serve as the parent span id.
map $request_id $ebaygroup5_parent_span {
    "~^(?<span>[0-9a-f]{16})" $span;
}

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

# F02 (SCALE_OUT.md): the DNS name returns every web replica; "resolve" (open source since 1.27.3) keeps the list current
# when a replica restarts with a new address. Round-robin across replicas; chat needs no stickiness (WebSockets only).
# F06 (K8S.md): compose passes Docker DNS 127.0.0.11 / web:8080; Kubernetes passes kube-dns / the headless web Service.
# F06: short DNS validity plus a short connect timeout: when a replica is replaced (K8s rollout) a cached address of the gone pod
# fails within 2 s and proxy_next_upstream (default: error timeout, idempotent requests) retries the next replica.
resolver ${NGINX_RESOLVER} valid=5s ipv6=off;

upstream ebaygroup5_web {
    zone ebaygroup5_web 64k;
    server ${WEB_UPSTREAM} resolve max_fails=1 fail_timeout=5s;
    keepalive 16;
}

server {
    listen 8080;
    access_log /dev/stdout ebaygroup5;
    return 308 https://$host:${PUBLIC_HTTPS_PORT}$request_uri;
}

server {
    listen 8443 ssl;
    http2 on;
    access_log /dev/stdout ebaygroup5;

    ssl_certificate /etc/nginx/tls/server.crt;
    ssl_certificate_key /etc/nginx/tls/server.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:ebaygroup5_tls:1m;
    ssl_session_timeout 10m;

    client_max_body_size 1m;

    proxy_http_version 1.1;
    proxy_connect_timeout 2s;

    # proxy_set_header is inherited only when a block sets none of its own, so every location repeats the common set.
    # Host keeps the client's port ($http_host): the app builds absolute redirects (login) from it; AllowedHosts still filters names.
    # Forwarding headers are overwritten (never appended); the app trusts them only from this proxy's address.
    location /hubs/chat {
        proxy_pass http://ebaygroup5_web;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Request-Id $request_id;
        proxy_set_header traceparent "00-$request_id-$ebaygroup5_parent_span-01";
        proxy_set_header tracestate "";
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_buffering off;
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
    }

    location / {
        proxy_pass http://ebaygroup5_web;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Request-Id $request_id;
        proxy_set_header traceparent "00-$request_id-$ebaygroup5_parent_span-01";
        proxy_set_header tracestate "";
        proxy_set_header Connection "";
    }
}
